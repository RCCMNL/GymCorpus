ios/Flutter/flutter_export_environment.sh
ios/ServiceDefinitions.json
ios/Flash/Generated.xcconfig
.xcworkspace/

# Secrets and local config
#
# Nota sulla configurazione Firebase: google-services.json,
# GoogleService-Info.plist e lib/firebase_options.dart sono volutamente
# versionati. Le API key che contengono sono identificatori pubblici lato
# client, non segreti: la protezione reale sta nelle regole Firestore, nelle
# restrizioni delle chiavi su Google Cloud e in App Check. Vedi
# FIREBASE_SETUP.md. Non aggiungere qui regole per ignorarli: in passato le
# regole c'erano ma i file erano gia' tracciati, quindi non avevano effetto e
# davano una falsa impressione di protezione.
.env
.env.*
dart_defines.json
*.keystore
*.jks
*.p12
*.pem
secrets.yaml
android/key.properties

# JS / web
node_modules/
npm-debug.log*
yarn-debug.log*
